# =============================================================
# Budget Buddy AI — Environment Variable Template
# =============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit your ".env" file to Git.
# =============================================================

# ─── Supabase (REQUIRED) ─────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# ─── Supabase Edge Function Secrets ──────────────────────────
# These are NOT prefixed with VITE_ — they live in Supabase,
# not the browser. Set them with: supabase secrets set KEY=value
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#   (Supabase Dashboard → Project Settings → API)
#
# OPENAI_API_KEY=sk-proj-...
#   (https://platform.openai.com/api-keys)
#   Used for the AI chat assistant (replaces Lovable AI gateway)
#
# RESEND_API_KEY=re_...
#   (https://resend.com/api-keys)
#   Used for budget overspending & daily reminder emails
